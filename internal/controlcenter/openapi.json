  "info": {
    "title": "GasCity Control Center API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/convoys": {
      "get": {
        "operationId": "get-api-v1-convoys",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceListConvoySummary"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get API v1 convoys"
      }
    },
    "/api/v1/convoys/{id}": {
      "get": {
        "operationId": "get-api-v1-convoys-by-id",
        "parameters": [
          {
            "description": "Tracking convoy bead ID.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Tracking convoy bead ID.",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConvoyDetail"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get API v1 convoys by ID"
      }
    },
    "/api/v1/convoys/{id}/beads": {
      "get": {
        "operationId": "get-api-v1-convoys-by-id-beads",
        "parameters": [
          {
            "description": "Tracking convoy bead ID.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Tracking convoy bead ID.",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceListBeadView"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get API v1 convoys by ID beads"
      }
    },
    "/api/v1/events": {
      "get": {
        "description": "Relays bounded invalidation hints. Clients re-read the affected authoritative resources.",
        "operationId": "streamControlCenterEvents",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "description": "A stream of invalidate events.",
                  "items": {
                    "properties": {
                      "data": {
                        "$ref": "#/components/schemas/Invalidation"
                      },
                      "event": {
                        "const": "invalidate",
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "event",
                      "id",
                      "data"
                    ],
                    "type": "object"
                  },
                  "title": "Control Center invalidation events",
                  "type": "array"
                }
              }
            },
            "description": "Server-sent invalidation events."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Stream authoritative-state invalidations"
      }
