      "get": {
        "operationId": "get-api-v1-orders-history",
        "parameters": [
          {
            "description": "Scoped order name.",
            "explode": false,
            "in": "query",
            "name": "scoped_name",
            "required": true,
            "schema": {
              "description": "Scoped order name.",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^\\S(.*\\S)?$",
              "type": "string"
            }
          },
          {
            "description": "Exclusive RFC3339 history cursor.",
            "explode": false,
            "in": "query",
            "name": "before",
            "schema": {
              "description": "Exclusive RFC3339 history cursor.",
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Maximum history rows.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "description": "Maximum history rows.",
              "format": "int64",
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceListOrderRunView"
                }
              }
            },
